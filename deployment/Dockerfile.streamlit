FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CROP_PULSE_ENVIRONMENT=production

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

# Vercel routes the original /planner/... path through to this service. Keep
# Streamlit's base path aligned so its assets and WebSocket endpoint use it.
CMD ["sh", "-c", "streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-3000} --server.baseUrlPath=planner"]
