# Copy values into your shell environment or a private .env loader. Never commit real secrets.
# CROP_PULSE_ENVIRONMENT must be explicitly set for the API process; production/staging require HTTPS origins.
# Local SQLite default is used when CROP_PULSE_DATABASE_URL is omitted.
CROP_PULSE_DATABASE_URL=sqlite:///./data/croppulse_phase1.sqlite3
CROP_PULSE_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CROP_PULSE_API_URL=http://127.0.0.1:8000
CROP_PULSE_STREAMLIT_URL=http://127.0.0.1:8501
CROP_PULSE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CROP_PULSE_COOKIE_SECURE=0
CROP_PULSE_ENVIRONMENT=development
# Optional self-service email change and password recovery; configure on API only.
CROP_PULSE_SMTP_HOST=
CROP_PULSE_SMTP_PORT=587
CROP_PULSE_SMTP_USERNAME=
CROP_PULSE_SMTP_PASSWORD=
CROP_PULSE_SMTP_FROM=
CROP_PULSE_SMTP_STARTTLS=1
CROP_PULSE_SMTP_USE_SSL=0
CROP_PULSE_PUBLIC_APP_URL=http://127.0.0.1:5173
# Development-only option to create tables automatically. Use Alembic migrations instead.
CROP_PULSE_AUTO_CREATE_SCHEMA=0
