# Copy values into your shell environment or a private .env loader. Never commit real secrets.
# PostgreSQL is required in every application runtime. Supply credentials via
# a private environment/secret manager; never commit a real database URL.
CROP_PULSE_DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@localhost:5432/croppulse_staging_pg
CROP_PULSE_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CROP_PULSE_API_URL=https://croppulse-rwanda.onrender.com
CROP_PULSE_STREAMLIT_URL=http://127.0.0.1:8501
CROP_PULSE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://croppulse-rwanda-1.onrender.com,https://croppulse-rwanda.onrender.com
CROP_PULSE_COOKIE_SECURE=1
CROP_PULSE_ENVIRONMENT=production
# Optional self-service email change and password recovery; configure on API only.
CROP_PULSE_SMTP_HOST=
CROP_PULSE_SMTP_PORT=587
CROP_PULSE_SMTP_USERNAME=
CROP_PULSE_SMTP_PASSWORD=
CROP_PULSE_SMTP_FROM=
CROP_PULSE_SMTP_STARTTLS=1
CROP_PULSE_SMTP_USE_SSL=0
CROP_PULSE_PUBLIC_APP_URL=https://croppulse-rwanda-1.onrender.com
# Development-only option to create tables automatically. Use Alembic migrations instead.
CROP_PULSE_AUTO_CREATE_SCHEMA=0
# Apply reviewed Alembic migrations when the API starts (default). Set to 0 to
# run `alembic upgrade head` yourself before deploying instead.
CROP_PULSE_RUN_MIGRATIONS_ON_START=1
