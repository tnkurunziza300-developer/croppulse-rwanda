# Template only. Copy into an approved secret/configuration store; do not commit populated values.
CROP_PULSE_ENVIRONMENT=staging
CROP_PULSE_DATABASE_URL=postgresql+psycopg://<staging-user>:<secret>@<private-db-host>/<staging-db>
CROP_PULSE_SECRET_KEY=<generate-a-unique-secret-of-at-least-32-bytes>
CROP_PULSE_CORS_ORIGINS=https://<private-staging-host>
CROP_PULSE_COOKIE_SECURE=1
CROP_PULSE_AUTO_CREATE_SCHEMA=0
CROP_PULSE_API_URL=https://<private-staging-host>
CROP_PULSE_PUBLIC_APP_URL=https://<private-staging-host>
